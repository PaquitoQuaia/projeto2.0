
CREATE DATABASE DB_truck_prts;

USE DB_truck_prts;


-- =========================================
-- ENDEREÇO
-- =========================================

CREATE TABLE ENDERECO (
    id_endereco INT AUTO_INCREMENT,
    cep VARCHAR(8) NOT NULL,
    numero VARCHAR(10) NOT NULL,
    complemento VARCHAR(100),

    PRIMARY KEY (id_endereco)
);


-- =========================================
-- USUÁRIO
-- =========================================

CREATE TABLE USUARIO (
    id_usuario INT AUTO_INCREMENT,
    id_endereco INT,

    nome VARCHAR(100) NOT NULL,
    data_nascimento DATE NOT NULL,
    cpf CHAR(11) NOT NULL UNIQUE,
    telefone VARCHAR(11) NOT NULL UNIQUE,
    email VARCHAR(100) NOT NULL UNIQUE,
    senha VARCHAR(255) NOT NULL,

    tipo_cadastro VARCHAR(20) NOT NULL,
    interesses VARCHAR(255),

    PRIMARY KEY (id_usuario),

    FOREIGN KEY (id_endereco)
        REFERENCES ENDERECO(id_endereco)
);


-- =========================================
-- PRODUTO
-- =========================================

CREATE TABLE PRODUTO (
    id_produto INT AUTO_INCREMENT,

    descricao_prod VARCHAR(500) NOT NULL,
    preco_prod DECIMAL(10,2) NOT NULL,
    marca_produto VARCHAR(50),
    categoria VARCHAR(50) NOT NULL,
    imagem VARCHAR(255),
    estoque INT NOT NULL DEFAULT 0,

    -- MODELO DO CAMINHÃO SCANIA
    modelo_scania VARCHAR(50),

    PRIMARY KEY (id_produto)
);


-- =========================================
-- CATÁLOGO
-- =========================================

CREATE TABLE CATALOGO (
    id_catalogo INT AUTO_INCREMENT,
    id_produto INT NOT NULL,
    secoes VARCHAR(50),

    PRIMARY KEY (id_catalogo),

    FOREIGN KEY (id_produto)
        REFERENCES PRODUTO(id_produto)
        ON DELETE CASCADE
);


-- =========================================
-- CARRINHO
-- =========================================

CREATE TABLE CARRINHO (
    id_carrinho INT AUTO_INCREMENT,

    id_produto INT NOT NULL,
    id_usuario INT NOT NULL,

    quantidade INT NOT NULL DEFAULT 1,
    subtotal DECIMAL(10,2) NOT NULL,

    cupom VARCHAR(20),

    PRIMARY KEY (id_carrinho),

    FOREIGN KEY (id_produto)
        REFERENCES PRODUTO(id_produto)
        ON DELETE CASCADE,

    FOREIGN KEY (id_usuario)
        REFERENCES USUARIO(id_usuario)
        ON DELETE CASCADE
);


-- =========================================
-- SUPORTE
-- =========================================

CREATE TABLE SUPORTE (
    id_suporte INT AUTO_INCREMENT,
    id_usuario INT NOT NULL,
    numero_wts VARCHAR(11),

    PRIMARY KEY (id_suporte),

    FOREIGN KEY (id_usuario)
        REFERENCES USUARIO(id_usuario)
        ON DELETE CASCADE
);


-- =========================================
-- FORMA DE PAGAMENTO
-- =========================================

CREATE TABLE FORMA_PAG (
    id_pag INT AUTO_INCREMENT,
    id_usuario INT NOT NULL,
    tipo_pagamento VARCHAR(20) NOT NULL,

    PRIMARY KEY (id_pag),

    FOREIGN KEY (id_usuario)
        REFERENCES USUARIO(id_usuario)
        ON DELETE CASCADE
);


-- =========================================
-- FINALIZAÇÃO
-- =========================================

CREATE TABLE FINAL_PAG (
    id_final_pag INT AUTO_INCREMENT,

    id_pag INT,
    id_carrinho INT,
    id_endereco INT,
    id_usuario INT NOT NULL,

    frete DECIMAL(10,2) DEFAULT 0.00,
    forma_de_envio VARCHAR(20),

    PRIMARY KEY (id_final_pag),

    FOREIGN KEY (id_pag)
        REFERENCES FORMA_PAG(id_pag),

    FOREIGN KEY (id_carrinho)
        REFERENCES CARRINHO(id_carrinho),

    FOREIGN KEY (id_endereco)
        REFERENCES ENDERECO(id_endereco),

    FOREIGN KEY (id_usuario)
        REFERENCES USUARIO(id_usuario)
        ON DELETE CASCADE
);


CREATE TABLE ITEM_CARRINHO (
    id_item_carrinho INT AUTO_INCREMENT,
    id_carrinho INT,
    id_produto INT,
    quantidade INT NOT NULL DEFAULT 1,
    preco_unitario DECIMAL(10,2) NOT NULL,

    CONSTRAINT pk_item_carrinho
        PRIMARY KEY (id_item_carrinho),

    CONSTRAINT fk_item_carrinho_carrinho
        FOREIGN KEY (id_carrinho)
        REFERENCES CARRINHO(id_carrinho)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    CONSTRAINT fk_item_carrinho_produto
        FOREIGN KEY (id_produto)
        REFERENCES PRODUTO(id_produto)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);


