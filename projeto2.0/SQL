-- =========================================
-- MODELOS SCANIA
-- =========================================

modelos AS (

    SELECT 1 AS id, 'R 450' AS modelo

    UNION ALL SELECT 2, 'R 500'

    UNION ALL SELECT 3, 'R 540'

    UNION ALL SELECT 4, 'R 620'

    UNION ALL SELECT 5, 'R 660'

    UNION ALL SELECT 6, 'R 730'

    UNION ALL SELECT 7, 'G 360'

    UNION ALL SELECT 8, 'G 410'

    UNION ALL SELECT 9, 'G 450'

    UNION ALL SELECT 10, 'G 500'

    UNION ALL SELECT 11, 'P 250'

    UNION ALL SELECT 12, 'P 280'

    UNION ALL SELECT 13, 'P 310'

    UNION ALL SELECT 14, 'P 320'

    UNION ALL SELECT 15, 'P 360'

    UNION ALL SELECT 16, 'P 410'

    UNION ALL SELECT 17, 'S 450'

    UNION ALL SELECT 18, 'S 500'

    UNION ALL SELECT 19, 'S 540'

    UNION ALL SELECT 20, 'S 730'
)

SELECT

    -- =====================================
    -- NOME + CÓDIGO
    -- =====================================

    CONCAT(
        pb.nome,
        ' ',
        LPAD(
            1000000000
            + (
                ((n.numero - 1) * 24)
                + pb.base_id
            ),
            10,
            '0'
        )
    ) AS descricao_prod,

    -- =====================================
    -- PREÇO
    -- =====================================

    ROUND(
        pb.preco
        +
        (
            (
                (n.numero * pb.base_id) % 17
            ) * 13.50
        ),
        2
    ) AS preco_prod,

    -- =====================================
    -- MARCA
    -- =====================================

    'Scania' AS marca_produto,

    -- =====================================
    -- CATEGORIA
    -- =====================================

    pb.categoria,

    -- =====================================
    -- IMAGEM
    -- =====================================

    pb.imagem,

    -- =====================================
    -- ESTOQUE
    -- =====================================

    5 + (
        (n.numero * pb.base_id) % 26
    ) AS estoque,

    -- =====================================
    -- MODELO SCANIA
    -- =====================================

    m.modelo AS modelo_scania

FROM numeros n

CROSS JOIN produtos_base pb

JOIN modelos m
    ON m.id =
       (
           (
               n.numero
               + pb.base_id
               - 2
           ) % 20
       ) + 1

WHERE
    (
        (n.numero - 1) * 24
        + pb.base_id
    ) <= 500

ORDER BY
    n.numero,
    pb.base_id;


